{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "notion-to-hindsight-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"workflows": [
		{
			"name": "notion-hindsight-sync",
			"binding": "NOTION_HINDSIGHT_SYNC",
			"class_name": "NotionHindsightSyncWorkflow",
			"concurrency": { "limit": 1 }
		}
	]
}
