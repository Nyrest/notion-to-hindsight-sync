# Required Notion integration secret:
NOTION_TOKEN="secret_notion_integration_token"
HINDSIGHT_BASE_URL="https://hindsight.example.com"
SYNC_TARGETS='[{"key":"personal","notionDataSourceId":"notion_data_source_id","hindsightBankId":"hindsight_bank_id"}]'

# Optional when Hindsight requires bearer authentication:
# HINDSIGHT_API_KEY="..."

# Optional when Hindsight is behind Cloudflare Access:
# CF_ACCESS_CLIENT_ID="..."
# CF_ACCESS_CLIENT_SECRET="..."
